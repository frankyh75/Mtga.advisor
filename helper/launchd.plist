<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      LaunchDaemon-Definition für com.mtga.helper.

      Wird installiert unter:
        /Library/LaunchDaemons/com.mtga.helper.plist

      Der Daemon läuft als root (implizit für LaunchDaemons in
      /Library/LaunchDaemons/) und lauscht auf dem UNIX Socket.

      KeepAlive=false → der Daemon startet nur, wenn ein Client
      sich zum Socket verbindet (socket-triggered OnDemand).
      Das spart Ressourcen, wenn kein Scan läuft.

      Falls der Helper dauerhaft laufen soll, setze KeepAlive=true.
    -->

    <key>Label</key>
    <string>com.mtga.helper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/mtga-helper</string>
        <string>--sock</string>
        <string>/var/run/mtga-helper.sock</string>
    </array>

    <!-- Socket-triggered OnDemand: Startet nur bei Verbindung -->
    <key>KeepAlive</key>
    <false/>

    <!-- Socket-Definition: UNIX Domain Socket -->
    <key>Sockets</key>
    <dict>
        <key>com.mtga.helper.sock</key>
        <dict>
            <key>SockType</key>
            <string>stream</string>
            <key>SockPathName</key>
            <string>/var/run/mtga-helper.sock</string>
            <key>SockPathMode</key>
            <integer>432</integer>  <!-- 0660 in decimal -->
        </dict>
    </dict>

    <!-- Standard-Output/Error in Systemlog -->
    <key>StandardOutPath</key>
    <string>/var/log/mtga-helper.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/mtga-helper.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <!-- Kein LimitLoadToSessionType: Für einen System-LaunchDaemon (in
         /Library/LaunchDaemons) ist die Restriktion auf Aqua/Background
         kontraproduktiv — sie verhindert, dass der Job im System-Domain
         registriert wird. Ohne diesen Key läuft der Daemon im Standard-
         System-Session und ist für alle User (CLI + GUI) erreichbar. -->
</dict>
</plist>