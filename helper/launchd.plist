<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      LaunchDaemon-Definition für com.mtga.helper.

      Wird installiert unter:
        /Library/LaunchDaemons/com.mtga.helper.plist

      Der Daemon läuft als root (implizit für LaunchDaemons in
      /Library/LaunchDaemons/) und lauscht auf dem UNIX Socket.

      Der Daemon erstellt den Socket selbst (bind() in main.c).
      KEIN Socket-Activation via launchd — der Sockets-Key wurde
      entfernt, weil main.c sein eigenes bind() + unlink() macht
      und die launchd-Socket-Activation damit konfligiert.

      RunAtLoad=true + KeepAlive=true: der Daemon startet beim
      Boot und läuft dauerhaft (selbst reparierend bei Crash).
      Das ist nötig, weil ohne Socket-Activation ein OnDemand-
      Daemon nicht zuverlässig bei Verbindung starten würde.
    -->

    <key>Label</key>
    <string>com.mtga.helper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/mtga-helper</string>
        <string>--sock</string>
        <string>/var/run/mtga-helper.sock</string>
    </array>

    <!-- Daemon startet beim Boot und läuft dauerhaft -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Standard-Output/Error in Systemlog -->
    <key>StandardOutPath</key>
    <string>/var/log/mtga-helper.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/mtga-helper.err.log</string>

    <!-- Kein LimitLoadToSessionType: Für einen System-LaunchDaemon (in
         /Library/LaunchDaemons) ist die Restriktion auf Aqua/Background
         kontraproduktiv — sie verhindert, dass der Job im System-Domain
         registriert wird. Ohne diesen Key läuft der Daemon im Standard-
         System-Session und ist für alle User (CLI + GUI) erreichbar. -->
</dict>
</plist>