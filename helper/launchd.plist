<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      LaunchDaemon-Definition für com.mtga.helper.

      Wird installiert unter:
        /Library/LaunchDaemons/com.mtga.helper.plist

      Der Daemon läuft als root (UserName=root ist implizit für
      LaunchDaemons in /Library/LaunchDaemons/), startet bei Bedarf
      (OnDemand) und lauscht auf dem UNIX Socket.

      KeepAlive=false → der Daemon startet nur, wenn ein Client
      sich zum Socket verbindet (Mach-Service-OnDemand).  Das
      spart Ressourcen, wenn kein Scan läuft.

      Falls der Helper immer laufen soll, setze KeepAlive=true.
    -->

    <key>Label</key>
    <string>com.mtga.helper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/mtga-helper</string>
        <string>--sock</string>
        <string>/tmp/mtga-helper.sock</string>
    </array>

    <!-- Bei Bedarf starten (Socket-triggered) -->
    <key>OnDemand</key>
    <true/>

    <!-- Socket-Definition: UNIX Domain Socket -->
    <key>Sockets</key>
    <dict>
        <key>com.mtga.helper.sock</key>
        <dict>
            <key>SockType</key>
            <string>stream</string>
            <key>SockPathName</key>
            <string>/tmp/mtga-helper.sock</string>
            <key>SockPathMode</key>
            <integer>432</integer>  <!-- 0660 in decimal -->
        </dict>
    </dict>

    <!-- Standard-Output/Error in Systemlog -->
    <key>StandardOutPath</key>
    <string>/var/log/mtga-helper.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/mtga-helper.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>